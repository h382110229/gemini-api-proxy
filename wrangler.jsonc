{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemini-api-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "your-proxy.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
